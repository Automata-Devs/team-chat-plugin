	close = "x",

	-- Media playback
	play = "play-large",
	pause = "pause-large",
	download = "arrow-down-to-line",

	-- Links and embeds
	website = "compass",
	link = "chain-link",

	-- Conversations sidebar
	sidebar = "sidebar",
	pinned = "pin",
	gameFallback = "cube",
