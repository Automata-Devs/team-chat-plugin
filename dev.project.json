{
  "name": "Team Chat Development",
  "globIgnorePaths": [
    "src/Packages",
    "src/Packages/**"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "TeamChatPlugin": {
        "$path": "src",
        "Packages": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "TeamChatTests": {
        "$path": "tests"
      }
    }
  }
}
