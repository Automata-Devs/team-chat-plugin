# Copy to .env and fill in. Every variable is described in docs/backend/OPERATIONS.md.

# Required
DATABASE_URL=postgres://teamchat:change-me@localhost:5432/teamchat
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Server
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=https://chat.example.com
LOG_LEVEL=info
TRUST_PROXY=false

# Several instances: set REDIS_URL (shared rate limits, sessions, events, worker ids)
REDIS_URL=
# Or give each instance its own 0-1023 by hand
WORKER_ID=

DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000
SESSION_TTL_DAYS=30
ALLOW_PASSWORD_SIGNUP=true
RUN_JOBS=true
RATE_LIMIT_SCALE=1

# Sign in with Roblox: an OAuth 2.0 app on create.roblox.com with the redirect URL
# <PUBLIC_URL>/api/v1/auth/roblox/callback and the scopes openid and profile
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=

# Attachments: any S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_BYTES=26214400

# docker-compose only
POSTGRES_PASSWORD=change-me
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Development only: lets bot event URLs be http:// or on private addresses
ALLOW_INSECURE_BOT_URLS=false
